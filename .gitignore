# ===== IDE / 编辑器 =====
.idea/
*.iml
*.ipr
*.iws

# ===== Maven 编译产物 =====
target/
**/target/

# ===== 日志 =====
# 日志内容不入库，但保留目录本身（否则新克隆的仓库里没有 logs/，
# 服务启动时 Boot 会自动建目录，位置却取决于进程工作目录，容易和预期不一致）
*.log
logs/*
!logs/.gitkeep

# ===== 本地凭据 / 环境变量（.env.example 是模板，允许提交）=====
.env
.env.local
*.env
!.env.example

# ===== Docker 数据卷（默认落在 managed volume，此处兜底）=====
docker/data/

# ===== 操作系统 =====
.DS_Store
Thumbs.db
