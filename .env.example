# 复制为 .env 后按需修改：cp .env.example .env
# .env 已被 .gitignore 忽略 —— 请勿把真实凭据提交进仓库。
# docker compose 会自动读取同目录的 .env（**只有 compose 读**，业务服务读的是进程环境变量）。
#
# ⚠️ 别盲目执行上面那行 cp —— 它会**无条件覆盖**已存在的 .env。
#    如果 .env 已经配好能用，直接编辑它，不要从本文件重新拷贝。
#
# 🚨 本文件（.env.example）与 .env **相反**：它被 .gitignore 用 `!.env.example` 显式放行，
#    是**要提交进仓库的模板**。所以这里只放占位值，**绝不能填真实密码 / 真实密钥** ——
#    要填真实值请填到 .env（那个才被忽略）。

# ---------- MySQL ----------
# ⚠️ MYSQL_PASSWORD 是**必填项**：compose 里写的是 ${MYSQL_PASSWORD:?...}，
#    留空会让 `docker compose up -d` 直接中止（容器只被 Created、不会启动），报
#    "required variable MYSQL_PASSWORD is missing a value"。
MYSQL_USERNAME=root
MYSQL_PASSWORD=

# ---------- JWT ----------
# mall-gateway 与 mall-service-user 必须使用同一个值，且不短于 32 字符。
# 生成一个：openssl rand -base64 32
#
# ⚠️ 注意：本项目 compose **不读**这项，也没有把它注入任何容器（业务服务是跑在宿主机的，
#    不在容器里）。两个 Spring 服务是从**进程环境变量**里读 `JWT_SECRET` 的，
#    所以**只写在这个文件里不起作用**，得用下面任一方式真正设进环境：
#      · PowerShell : $env:JWT_SECRET = "..."  或  setx JWT_SECRET "..."
#      · bash       : export JWT_SECRET='...'
#      · IDE        : Run Configuration 的 Environment variables（gateway 与 user 两个都要配）
JWT_SECRET=

# ---------- RabbitMQ（可选）----------
# 留空即沿用默认的 guest/guest（compose 已放开 loopback 限制，宿主机可直连）
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# ---------- 中间件宿主机端口（可选）----------
# compose 默认把宿主机端口**错开**，以便与本机已装的 MySQL / Redis / RabbitMQ / Nacos
# 并存而不抢端口。要占标准端口（此时须先停掉本机对应中间件），取消注释并改值：
#
# MYSQL_PORT=3306            # 默认 3307（本机原生 MySQL80 占 3306）
# REDIS_PORT=6379            # 默认 6380（WSL 里的 Redis 占 6379）
# RABBITMQ_PORT=5672         # 默认 5673（WSL 里的 RabbitMQ 占 5672）
# RABBITMQ_MGMT_PORT=15672   # 默认 15673
# NACOS_PORT=8848            # 默认 8858（本机 nacos 占 8848）
# NACOS_GRPC_PORT=9848       # 默认 9858，须等于 NACOS_PORT + 1000
# NACOS_RAFT_PORT=9849       # 默认 9859，须等于 NACOS_PORT + 1001
#
# 注意：业务服务是按**标准端口**连中间件的（数据源地址在 Nacos 配置里、
# RabbitMQ 在各自 application.yml 里）。所以端口错开时，容器只是并存可用，
# 服务连的仍是本机那套中间件。

# ---------- Nacos 鉴权变量（可选）----------
# ⚠️ 即使 NACOS_AUTH_ENABLE=false，Nacos 3.x 镜像的启动脚本仍会**无条件校验**这三项，
#    任一为空就 exit 255，配上 restart: unless-stopped 会变成无限重启
#    （docker compose ps 显示 Restarting，日志末行是 "env NACOS_AUTH_xxx must be set"）。
#    compose 里已给了一组演示用占位默认值，开箱即用；真开了鉴权就必须换成自己的。
#
# NACOS_AUTH_TOKEN=              # 必须 Base64，且**解码后长度 >= 32 字符**（生成：openssl rand -base64 32）
# NACOS_AUTH_IDENTITY_KEY=       # 非空即可
# NACOS_AUTH_IDENTITY_VALUE=     # 非空即可
