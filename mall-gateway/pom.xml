<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.example</groupId>
        <artifactId>mall</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>
    <artifactId>mall-gateway</artifactId>

    <dependencies>
        <!--
            仅为了 com.model.constant.RedisKeys（与 mall-service-user 共享的 Redis 键契约）。
            注意：这与「网关不依赖 mall-common」不冲突——mall-common 是 servlet 系的运行时模块，
            而 model 是技术栈中立的契约模块（只依赖 spring-web + slf4j-api，均为 WebFlux 已有）。
            其 @RestControllerAdvice 在 com.model 包下，网关只扫 com.gateway，不会被注册。
        -->
        <dependency>
            <groupId>org.example</groupId>
            <artifactId>model</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <!-- Spring Cloud Gateway（Boot 4 / Cloud 2025.1 新 starter，reactive） -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway-server-webflux</artifactId>
        </dependency>
        <!-- 注册发现：按服务名 lb:// 路由到下游微服务 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>
        <!-- Redis：校验登录 token 是否仍有效/单设备登录 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- 健康检查与运行指标（/actuator/health、/actuator/prometheus） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Prometheus 抓取端点。详见 mall-service/pom.xml 里同一坐标上的注释（版本别写死、别用 -simpleclient 变体） -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!-- java-jwt 版本由父 pom 统一管理（解析 JWT） -->
    </dependencies>

</project>
